    "examples": [
      {
        "outlet": "bbc",
        "label": "Applicants and talent visas",
        "explanation": "The morning headline says firms helped applicants pose as artists or tech experts. It attributes the pretence to applicants as well as their advisers. This meets the explicit portrayal rule.",
        "dateLabel": "13 November",
        "url": "https://www.bbc.co.uk/news/articles/cmkgdw24l1kdo"
      },
      {
        "outlet": "bbc",
        "label": "The same visa investigation, four hours later",
        "explanation": "The midday wording puts the offer to fake art in the hands of a firm. Wealthy migrant applicants are associated with the offer, but the card leaves open whether they took it up. Only the broader count includes this wording.",
        "dateLabel": "13 November",
        "url": "https://www.bbc.co.uk/news/articles/cmkgdw24l1kdo"
      },
      {
        "outlet": "bbc",
        "label": "Advice about an illegal-worker fine",
        "explanation": "The phrase “illegal-worker” links workers with illegality, while the report investigates a lawyer’s advice. This adds three checks under the broader reading. Multiple cards at the same check count once.",
        "dateLabel": "21 October",
        "url": "https://www.bbc.co.uk/news/articles/c30rln4pz58xo"
      },
      {
        "outlet": "bbc",
        "label": "An undercover reporter is offered fake art",
